{
  "name": "annual-plan-review",
  "version": "1.0.0",
  "private": true,
  "description": "Annual Plan Review with Render-ready PostgreSQL persistence",
  "main": "server.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser/review-features.cjs",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "init-db-pg": "npm --prefix backend run init-db-pg",
    "init-db": "npm --prefix backend run init-db",
    "test:all": "node --test tests/*.test.js backend/test/*.test.js"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
