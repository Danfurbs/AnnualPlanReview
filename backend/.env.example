# Server Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
# Choose ONE of the following options:

# Option 1: PostgreSQL (recommended for production, free on Render)
# Uncomment to use PostgreSQL:
# USE_POSTGRESQL=true
# DATABASE_URL=postgresql://user:password@host:5432/database
# Note: Render automatically provides DATABASE_URL in production

# Option 2: SQLite (default for local development)
DATABASE_PATH=./db/apr.db

# CORS Configuration
# For development, use http://localhost:5500 or your development server
# For production, use your frontend URL (e.g., https://yourapp.onrender.com)
CORS_ORIGIN=*

# Optional: API Security
# Uncomment and set if you want to add API key authentication
# API_KEY=your-secret-api-key-here
